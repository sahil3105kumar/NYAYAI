# surya batch sizes - tuned for RTX 4050 6GB
# bump RECOGNITION_BATCH_SIZE up to 48 or 64 if you have vram headroom
RECOGNITION_BATCH_SIZE=32
DETECTOR_BATCH_SIZE=4

# surya device - auto detects but explicit is safer
TORCH_DEVICE=cuda


# Infrastructure
QDRANT_URL=http://localhost:6333



# Mistral AI API Key (Used for Agent Routing & Graph Cypher Generation)
MISTRAL_API_KEY=your_mistral_api_key_here

# Neo4j Graph Database Configuration (Graph RAG)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Hugging Face Access Token 
HF_TOKEN=your_huggingface_read_token_here